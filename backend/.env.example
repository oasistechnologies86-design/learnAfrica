# ── LearnAfrica backend environment ──────────────────────────────────────────
# Copy to backend/.env for local development. In production these are set in the
# hosting dashboard (see backend/render.yaml). Never commit a real .env.

# ── Required ─────────────────────────────────────────────────────────────────
# Signing key for sessions and JWTs. Must be at least 32 characters and unique
# per environment; the app refuses to start in production without it.
SECRET_KEY=change-me-to-a-long-random-unique-value-32chars-plus
# Optional separate JWT signing key (defaults to SECRET_KEY).
# JWT_SECRET=

# 'production' enables the strict secret and payment guards. Anything else is
# treated as development.
FLASK_ENV=development

# ── Public site address ──────────────────────────────────────────────────────
# The frontend's own URL. Used for the sitemap, share/verification links and the
# CORS allowlist. Set it in the deployment environment so changing domain needs
# no code change. Leave blank in development to fall back to the request host.
SITE_URL=
# FRONTEND_URL and APP_URL are accepted as fallbacks for the same value.
# FRONTEND_URL=
# APP_URL=

# Exact browser origins allowed to call the API (comma-separated, no trailing
# slash). Required in production; defaults to localhost in development.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Public base URL of this backend (used for the Google OAuth callback).
# BACKEND_URL=

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string. When unset the app uses SQLite at DATABASE_PATH.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DATABASE_PATH=instance/learnafrica.db

# ── Payments (required in production) ────────────────────────────────────────
# Without this the app refuses to run payments in mock mode in production.
# PAYSTACK_SECRET_KEY=sk_test_xxx
# PAYSTACK_CALLBACK_URL=https://your-site.com/payment/return

# ── Email OTP (SendPulse) ────────────────────────────────────────────────────
# All three are required for signup email verification to work.
# SENDPULSE_CLIENT_ID=
# SENDPULSE_CLIENT_SECRET=
# SENDPULSE_SENDER_EMAIL=
# SENDPULSE_SENDER_NAME=LearnAfrica

# ── Google OAuth (Sign in with Google + Gmail senders) ───────────────────────
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# ── File uploads (Supabase Storage) ──────────────────────────────────────────
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# SUPABASE_STORAGE_BUCKET=

# ── First-run owner bootstrap ────────────────────────────────────────────────
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# ── Optional tuning (defaults shown) ─────────────────────────────────────────
# PORT=5000
# MAX_CONTENT_LENGTH=104857600
# JWT_EXPIRATION_HOURS=24
# QUIZ_PASS_SCORE=70
# OTP_EXPIRY_MINUTES=10
# OTP_RESEND_COOLDOWN_SECONDS=60
# RESET_LINK_HOURS=1
# RESET_RESEND_COOLDOWN_SECONDS=60
# PASS_MIN_LENGTH=8
