# ── LearnAfrica frontend environment ─────────────────────────────────────────
# Copy to frontend/.env.local for local development. Vite embeds these values
# into the build, so set them in the Vercel dashboard and redeploy after any
# change. Only VITE_* variables are exposed to the browser — never put secrets
# here.

# Base URL of the backend API. Leave blank in development to use the Vite proxy.
# In production set it to the backend's public URL, e.g.
# VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=

# The site's own public URL. Drives robots.txt, sitemap.xml and share/verify
# links, so changing domain is an environment change, not a code change.
# On Vercel you can also leave this unset and let VERCEL_URL fill it in.
VITE_SITE_URL=

# Google OAuth client ID (public, not a secret). Must match the backend's
# GOOGLE_OAUTH_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
